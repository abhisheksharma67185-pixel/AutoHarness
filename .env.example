# ============================================================
# AutoHarness Studio — Frontend / Next.js Environment Variables
# Copy to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------------
# DATABASE (PostgreSQL — SQLite no longer supported)
# ------------------------------------------------------------------
# Use your Supabase Transaction Pooler URL for Next.js server connection:
#   https://supabase.com/dashboard/project/_/settings/database
# Under "Transaction pooler" → copy the URL, replace [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:6543/postgres

# ------------------------------------------------------------------
# SUPABASE (Client-side)
# ------------------------------------------------------------------
# These are used by the browser Supabase client (supabaseBrowser)
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------
# SUPABASE (Server-side — Service Role Key)
# ------------------------------------------------------------------
# Used by server-side Supabase client (supabaseServer) for full write access
# ⚠️ NEVER expose this in client code. Keep it server-side only.
# Get from: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------
# PostHog Analytics (optional)
# ------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------------------------------
# STUDIO API Key (optional — requires X-API-Key header on API routes)
# ------------------------------------------------------------------
STUDIO_API_KEY=your-secret-api-key
