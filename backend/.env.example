# ============================================================
# AutoHarness Studio — Backend Environment Variables
# Copy to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------------
# DATABASE (PostgreSQL — SQLite no longer supported)
# ------------------------------------------------------------------
# Use your Supabase Transaction Pooler URL for backend connection:
#   https://supabase.com/dashboard/project/_/settings/database
# Under "Transaction pooler" → copy the URL, replace [YOUR-PASSWORD]
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# ------------------------------------------------------------------
# LLM (llama.cpp OpenAI-compatible server)
# ------------------------------------------------------------------
LLM_PROFILE=local_llama_cpp
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=dummy
LLM_MODEL=local-llama-8b

# ------------------------------------------------------------------
# HARBOR
# ------------------------------------------------------------------
HARBOR_BIN=harbor                    # or absolute path, e.g. /usr/local/bin/harbor
HARBOR_JOBS_DIR=./harbor_jobs        # where Harbor writes job artifacts
TB_DATASET=terminal-bench@2.0        # benchmark dataset slug

# ------------------------------------------------------------------
# STUDIO
# ------------------------------------------------------------------
STUDIO_API_KEY=                      # optional: set to require X-API-Key header
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
ENVIRONMENT=development            # development | production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
